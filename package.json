{
  "name": "coletivo-inspira",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "sites:dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "sites:build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "sites:start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "^19.2.7",
    "typescript": "6.0.3",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.9",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "type": "module"
